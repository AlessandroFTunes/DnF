  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@dnf/core": "workspace:*",
    "@dnf/sdk": "workspace:*",
    "@dnf/ui-react-native": "workspace:*",
    "@expo-google-fonts/cinzel": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.26",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-gl": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/three": "^0.186.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "expo": "sh scripts/expo.sh",
    "start": "bun expo start",
    "dev": "sh scripts/dev.sh",
    "android": "bun expo start --android",
    "phone": "sh scripts/phone.sh",
    "ios": "bun expo start --ios",
    "web": "bun expo start --web",
    "db:down": "docker compose -f ../../compose.yaml down",
    "db:logs": "docker compose -f ../../compose.yaml logs -f pocketbase",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "sounds": "bun --env-file=../../.env scripts/sounds.ts"
