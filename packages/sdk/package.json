{
  "name": "@dnf/sdk",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./srd": "./src/srd/index.ts"
  },
  "scripts": {
    "typecheck": "tsc",
    "srd:spec": "curl -sf -H \"CF-Access-Client-Id: $CF_ACCESS_CLIENT_ID\" -H \"CF-Access-Client-Secret: $CF_ACCESS_CLIENT_SECRET\" ${SRD_URL:-https://5e-fastapi.developale.com}/openapi.json | python3 -m json.tool --indent 2 > openapi/5e-fastapi.json",
    "srd:gen": "openapi-typescript openapi/5e-fastapi.json -o src/srd/5e-fastapi.d.ts"
  },
  "dependencies": {
    "@dnf/core": "workspace:*",
    "openapi-fetch": "^0.17.0",
    "pocketbase": "^0.28.1"
  },
  "devDependencies": {
    "@dnf/tsconfig": "workspace:*",
    "openapi-typescript": "^7.13.0"
  }
}
