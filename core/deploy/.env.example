# Copie para `.env` no NAS (nunca versione o `.env` de verdade). Gere os segredos com: openssl rand -hex 32
POSTGRES_PASSWORD=
AUTH_SECRET=

# Só o CORS de quem abre o app em outro endereço (ex.: o DM-Control local). O app web do mesmo domínio não precisa.
CORS_ORIGINS=

# 5e-FastAPI (token do Cloudflare Access; ou DND_API_URL=http://5e-fastapi:8000 na mesma rede, sem token)
DND_API_ACCESS_ID=
DND_API_ACCESS_SECRET=
DND_API_URL=

# Narração (provedores em ordem; Piper do NAS como reserva do Grande Sábio)
TTS_PROVIDERS=elevenlabs
ELEVENLABS_API_KEY=
PIPER_URL=
